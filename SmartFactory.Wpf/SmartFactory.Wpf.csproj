<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- WPF 外壳通过项目引用访问应用抽象，并组合基础设施实现。 -->
    <ProjectReference Include="..\SmartFactory.Application\SmartFactory.Application.csproj" />
    <ProjectReference Include="..\SmartFactory.Domain\SmartFactory.Domain.csproj" />
    <ProjectReference Include="..\SmartFactory.Infrastructure\SmartFactory.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
