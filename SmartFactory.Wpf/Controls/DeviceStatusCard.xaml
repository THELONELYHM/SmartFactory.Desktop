<UserControl x:Class="SmartFactory.Wpf.Controls.DeviceStatusCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="150">
    <Border Style="{StaticResource CardStyle}" Padding="20">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding Title,RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Value,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/></StackPanel>
            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="13" Background="{Binding Status,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource DeviceStatusBrush}}" Opacity=".9"><TextBlock Text="↗" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid>
    </Border>
</UserControl>
<!-- 自定义设备状态卡片的视图结构，数据通过 DependencyProperty 绑定。 -->
