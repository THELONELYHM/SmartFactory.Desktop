<UserControl x:Class="SmartFactory.Wpf.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Width="620" HorizontalAlignment="Left"><TextBlock Text="系统设置" Style="{StaticResource PageTitle}"/><TextBlock Text="调整本地实时管线与报警策略" Style="{StaticResource CaptionText}" Margin="0,7,0,22"/><Border Style="{StaticResource CardStyle}" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="64"/><RowDefinition Height="64"/><RowDefinition Height="64"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="实时 UI 刷新间隔" FontWeight="SemiBold"/><TextBlock Text="建议 100–300ms，采集频率与界面刷新解耦" Style="{StaticResource CaptionText}"/></StackPanel><TextBox Grid.Column="1" Text="{Binding UiRefreshIntervalMs}"/><StackPanel Grid.Row="1"><TextBlock Text="启用实时模拟器" FontWeight="SemiBold"/><TextBlock Text="关闭后保留当前界面快照" Style="{StaticResource CaptionText}"/></StackPanel><CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SimulationEnabled}" VerticalAlignment="Center" Content="运行"/><StackPanel Grid.Row="2"><TextBlock Text="报警温度阈值" FontWeight="SemiBold"/><TextBlock Text="单位：摄氏度" Style="{StaticResource CaptionText}"/></StackPanel><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WarningTemperature}"/><StackPanel Grid.Row="3"><TextBlock Text="深色主题" FontWeight="SemiBold"/><TextBlock Text="主题扩展占位，后续可接入动态资源" Style="{StaticResource CaptionText}"/></StackPanel><CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding DarkTheme}" VerticalAlignment="Center" Content="启用（预览）"/><Button Grid.Row="4" Grid.Column="1" Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/></Grid></Border><Border Background="#EDF2FF" CornerRadius="9" Padding="15" Margin="0,16,0,0"><TextBlock Text="安全提示：客户端 RBAC 只用于界面可见性与操作引导，不构成生产系统的安全边界；真实 API 必须再次鉴权。" TextWrapping="Wrap" Foreground="#3154A5"/></Border></StackPanel></UserControl>
<!-- 系统设置页面：编辑本地实时刷新与报警阈值参数。 -->
<!--
  设置表单绑定 ISettingsService 的可调参数。保存时 ViewModel 负责范围裁剪、
  更新实时服务开关并写入 LocalApplicationData，View 层不直接操作文件。
-->
