<UserControl x:Class="SmartFactory.Wpf.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:SmartFactory.Wpf.Controls"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid><StackPanel><TextBlock Text="生产总览" Style="{StaticResource PageTitle}"/><TextBlock Text="实时掌握产线健康度与关键运营指标" Style="{StaticResource CaptionText}" Margin="0,7,0,0"/></StackPanel><Button Content="刷新数据" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><UniformGrid Columns="4" Margin="0,24,0,22"><c:DeviceStatusCard Title="设备总数" Value="{Binding TotalDevices}" Status="Online" Margin="0,0,14,0"/><c:DeviceStatusCard Title="在线运行" Value="{Binding OnlineDevices}" Status="Online" Margin="0,0,14,0"/><c:DeviceStatusCard Title="离线设备" Value="{Binding OfflineDevices}" Status="Offline" Margin="0,0,14,0"/><c:DeviceStatusCard Title="故障设备" Value="{Binding FaultDevices}" Status="Fault"/></UniformGrid><UniformGrid Columns="3" Margin="0,0,0,22"><c:DeviceStatusCard Title="今日报警" Value="{Binding TodayAlarms}" Status="Warning" Margin="0,0,14,0"/><c:DeviceStatusCard Title="Critical 未确认" Value="{Binding CriticalAlarms}" Status="Fault" Margin="0,0,14,0"/><c:DeviceStatusCard Title="待处理工单" Value="{Binding PendingWorkOrders}" Status="Maintenance"/></UniformGrid><Border Style="{StaticResource CardStyle}" Padding="20"><StackPanel><TextBlock Text="最近报警" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/><ItemsControl ItemsSource="{Binding RecentAlarms}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{Binding Level,Converter={StaticResource AlarmLevelBrush}}"/><TextBlock Grid.Column="1" Text="{Binding DeviceCode}" Margin="12,0" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding DeviceName}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="3" Text="{Binding Message}"/><TextBlock Grid.Column="4" Text="{Binding OccurredAt,StringFormat={}{0:MM-dd HH:mm}}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
<!-- 生产总览页面：使用卡片展示来自数据库的聚合指标和最近报警。 -->
<!--
  首页不直接查询数据库，所有数字来自 DashboardViewModel。
  DeviceStatusCard 通过 DependencyProperty 接收标题、值和状态，最近报警使用 ItemsControl 展示。
-->
