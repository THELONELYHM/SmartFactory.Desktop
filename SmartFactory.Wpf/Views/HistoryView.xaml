<UserControl x:Class="SmartFactory.Wpf.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="历史数据" Style="{StaticResource PageTitle}"/><Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,16" Padding="15"><StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DeviceName" Width="210"/><DatePicker SelectedDate="{Binding From}" Width="150" Margin="10,0"/><DatePicker SelectedDate="{Binding To}" Width="150" Margin="0,0,10,0"/><Button Content="查询历史" Command="{Binding QueryCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Border><Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="2"><DataGrid ItemsSource="{Binding Records}"><DataGrid.Columns><DataGridTextColumn Header="时间戳" Binding="{Binding Timestamp,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="*"/><DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="120"/><DataGridTextColumn Header="温度 ℃" Binding="{Binding Temperature,StringFormat=F2}" Width="150"/><DataGridTextColumn Header="压力 MPa" Binding="{Binding Pressure,StringFormat=F3}" Width="150"/><DataGridTextColumn Header="转速 RPM" Binding="{Binding Speed,StringFormat=F0}" Width="150"/></DataGrid.Columns></DataGrid></Border><Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="{Binding TotalCount,StringFormat=共 {0} 条遥测记录}" Foreground="{StaticResource TextSecondaryBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="上一页" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding PageIndex}" Margin="15,0" VerticalAlignment="Center"/><TextBlock Text="/" VerticalAlignment="Center"/><TextBlock Text="{Binding TotalPages}" Margin="15,0" VerticalAlignment="Center"/><Button Content="下一页" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel></Grid></Grid></UserControl>
<!-- 历史遥测页面：设备、时间范围和分页查询条件。 -->
<!--
  历史查询的日期、设备和页码由 HistoryViewModel 管理；DataGrid 只接收当前页记录，
  上一页/下一页命令会重新执行分页查询，避免一次性加载大量遥测数据。
-->
