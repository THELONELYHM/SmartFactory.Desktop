<UserControl x:Class="SmartFactory.Wpf.Views.WorkOrderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="运维工单" Style="{StaticResource PageTitle}"/><Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"/><ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Margin="10,0"/><StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="新建工单" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Padding="2"><DataGrid ItemsSource="{Binding WorkOrders}" SelectedItem="{Binding SelectedOrder}"><DataGrid.Columns><DataGridTextColumn Header="工单号" Binding="{Binding OrderNo}" Width="160"/><DataGridTextColumn Header="设备" Binding="{Binding DeviceCode}" Width="90"/><DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="80"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="负责人" Binding="{Binding Assignee}" Width="100"/><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt,StringFormat={}{0:MM-dd HH:mm}}" Width="110"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,0,0" Padding="20"><StackPanel><TextBlock Text="工单编辑" Style="{StaticResource SectionTitle}"/><TextBlock Text="设备编号" Style="{StaticResource CaptionText}" Margin="0,20,0,6"/><TextBox Text="{Binding Editor.DeviceCode,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"/><TextBlock Text="故障描述" Style="{StaticResource CaptionText}" Margin="0,14,0,6"/><TextBox Text="{Binding Editor.Description,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Height="78" TextWrapping="Wrap" AcceptsReturn="True"/><TextBlock Text="优先级" Style="{StaticResource CaptionText}" Margin="0,14,0,6"/><ComboBox ItemsSource="{Binding Editor.Priorities}" SelectedItem="{Binding Editor.Priority}"/><TextBlock Text="负责人" Style="{StaticResource CaptionText}" Margin="0,14,0,6"/><TextBox Text="{Binding Editor.Assignee}"/><WrapPanel Margin="0,20,0,0"><Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="开始" Command="{Binding StartCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="完成" Command="{Binding CompleteCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/></WrapPanel></StackPanel></Border></Grid></Grid></UserControl>
<!-- 工单页面：左侧分页列表，右侧编辑表单和状态流转操作。 -->
<!--
  工单采用“列表 + 编辑器”布局。编辑器字段绑定 ObservableValidator，
  ValidatesOnDataErrors 会让输入错误通过 WPF Binding 反馈，而不是依赖 MessageBox。
-->
