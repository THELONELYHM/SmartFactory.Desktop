<Window x:Class="SmartFactory.Wpf.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartFactory.Wpf.ViewModels" xmlns:v="clr-namespace:SmartFactory.Wpf.Views" Title="SmartFactory · 智能产线运维平台" Width="1440" Height="900" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
 <Window.Resources><DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate><DataTemplate DataType="{x:Type vm:DeviceListViewModel}"><v:DeviceListView/></DataTemplate><DataTemplate DataType="{x:Type vm:AlarmViewModel}"><v:AlarmView/></DataTemplate><DataTemplate DataType="{x:Type vm:WorkOrderViewModel}"><v:WorkOrderView/></DataTemplate><DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView/></DataTemplate><DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource SidebarBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition/><RowDefinition Height="100"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="22,20"><Border Width="42" Height="42" Background="{StaticResource PrimaryBrush}" CornerRadius="12"><TextBlock Text="SF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,2"><TextBlock Text="SmartFactory" Foreground="White" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="OPS CONSOLE" Foreground="#66758D" FontSize="9"/></StackPanel></StackPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}"><ItemsControl.ItemTemplate><DataTemplate><RadioButton Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="17" Width="34"/><TextBlock Text="{Binding Label}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Grid.Row="2" BorderBrush="#223047" BorderThickness="0,1,0,0" Padding="22,17"><StackPanel><TextBlock Text="产线数据中心" Foreground="#91A0B5" FontSize="11"/><TextBlock Text="●  本地节点运行正常" Foreground="#42D3A3" Margin="0,8,0,0" FontSize="11"/></StackPanel></Border></Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition/></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="26,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#1FC98B"/><TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#EDF2FF" CornerRadius="18" Padding="12,7"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding RoleName}" Foreground="{StaticResource TextSecondaryBrush}" Margin="9,0,0,0"/></StackPanel></Border><Button Content="退出" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="14,7"/></StackPanel></Grid></Border><ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="26"/></Grid>
 </Grid>
</Window>
<!-- 主窗口 Shell：左侧导航、顶部状态栏和 ContentControl 页面承载区。 -->
<!--
  主 Shell 只创建一个窗口：左侧菜单负责导航，顶部显示连接和用户状态，
  ContentControl 根据 CurrentViewModel 的运行时类型选择对应 DataTemplate。
-->
