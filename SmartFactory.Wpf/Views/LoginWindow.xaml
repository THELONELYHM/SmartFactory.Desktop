<Window x:Class="SmartFactory.Wpf.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SmartFactory 登录" Width="980" Height="620" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#0C1424">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions>
  <Grid Margin="56"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Center"><Border Width="58" Height="58" Background="#3867F4" CornerRadius="17" HorizontalAlignment="Left"><TextBlock Text="SF" Foreground="White" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="智造，让每一次运转&#10;都清晰可见。" Foreground="White" FontSize="34" FontWeight="SemiBold" LineHeight="48" Margin="0,28,0,16"/><TextBlock Text="设备监控 · 报警响应 · 运维闭环 · 数据追溯" Foreground="#8DA0BC" FontSize="14"/></StackPanel><TextBlock Grid.Row="1" Text="SMART FACTORY OPERATIONS CONSOLE  ·  2026" Foreground="#52627A" FontSize="10"/></Grid>
  <Border Grid.Column="1" Background="#F7F9FC" CornerRadius="28,0,0,28"><StackPanel Width="310" VerticalAlignment="Center"><TextBlock Text="欢迎回来" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="登录智能产线运维工作台" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,30"/><TextBlock Text="用户名" Style="{StaticResource CaptionText}" Margin="0,0,0,7"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="密码" Style="{StaticResource CaptionText}" Margin="0,18,0,7"/><PasswordBox x:Name="PasswordInput" Padding="11,9" PasswordChanged="PasswordChanged"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" Margin="0,12,0,0" TextWrapping="Wrap"/><Button Content="进入系统" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" Height="44"/><TextBlock Text="演示账号：admin / admin123" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0"/></StackPanel></Border>
 </Grid>
</Window>
<!-- 登录窗口：负责收集账号密码，业务认证由 LoginViewModel 完成。 -->
<!--
  左侧为品牌说明区，右侧为登录表单。
  TextBox 通过 TwoWay Binding 更新 Username；PasswordBox 是 WPF 特殊控件，
  因为 Password 不是普通依赖属性，所以由 LoginWindow.xaml.cs 转发到 ViewModel。
-->
