<UserControl x:Class="SmartFactory.Wpf.Views.DeviceListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="设备监控" Style="{StaticResource PageTitle}"/><Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" ToolTip="按编号或名称搜索"/><ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Margin="10,0"/><StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="新增设备" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Padding="2"><DataGrid ItemsSource="{Binding DevicesView}" SelectedItem="{Binding SelectedDevice}" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="设备编号" Binding="{Binding DeviceCode}" Width="100"/><DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="170"/><DataGridTemplateColumn Header="状态" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding Status,Converter={StaticResource DeviceStatusBrush}}"/><TextBlock Text="{Binding Status}" Margin="7,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="温度 ℃" Binding="{Binding Temperature,StringFormat=F1}" Width="80"/><DataGridTextColumn Header="压力 MPa" Binding="{Binding Pressure,StringFormat=F2}" Width="85"/><DataGridTextColumn Header="转速 RPM" Binding="{Binding Speed,StringFormat=F0}" Width="90"/><DataGridTextColumn Header="位置" Binding="{Binding Location}" Width="*"/><DataGridTextColumn Header="更新时间" Binding="{Binding LastUpdateTime,StringFormat={}{0:HH:mm:ss}}" Width="90"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,0,0" Padding="20" Visibility="{Binding SelectedDevice,Converter={StaticResource NullToVisibility}}"><StackPanel><TextBlock Text="设备档案" Style="{StaticResource SectionTitle}"/><TextBlock Text="编号" Style="{StaticResource CaptionText}" Margin="0,20,0,6"/><TextBox Text="{Binding SelectedDevice.DeviceCode}" IsReadOnly="True"/><TextBlock Text="名称" Style="{StaticResource CaptionText}" Margin="0,14,0,6"/><TextBox Text="{Binding SelectedDevice.DeviceName}"/><TextBlock Text="设备类型" Style="{StaticResource CaptionText}" Margin="0,14,0,6"/><TextBox Text="{Binding SelectedDevice.DeviceType}"/><TextBlock Text="安装位置" Style="{StaticResource CaptionText}" Margin="0,14,0,6"/><TextBox Text="{Binding SelectedDevice.Location}"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="保存" Command="{Binding SaveSelectedCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/></StackPanel></StackPanel></Border></Grid></Grid></UserControl>
<!-- 设备监控页面：搜索、状态过滤、虚拟化列表和设备档案编辑面板。 -->
<!--
  左侧 DataGrid 绑定 ICollectionView，因此搜索和状态筛选不会重建集合；
  右侧详情面板只在 SelectedDevice 非空时显示，按钮命令由角色权限控制。
-->
